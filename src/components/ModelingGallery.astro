---
import { modelingLocations, allModelingPhotos } from '../data/modeling-portfolio';

let globalIndex = 0;
---

<section class="modeling-gallery" aria-label="Modeling portfolio by location" data-modeling-gallery>
  {modelingLocations.map((loc, locIndex) => {
    return (
      <article
        class="location-section"
        id={`location-${loc.id}`}
        data-location
        style={`--loc: ${locIndex};`}
      >
        <header class="location-header" data-parallax-header>
          <h2 class="location-title">{loc.label}</h2>
        </header>

        <div class="photo-grid" role="list">
          {loc.photos.map((photo, j) => {
            const index = globalIndex++;
            return (
              <button
                class="photo-cell"
                data-index={index}
                data-global-index={index}
                aria-label={`View ${loc.label} photo ${j + 1}`}
                type="button"
                role="listitem"
                style={`--j: ${j}`}
              >
                <span class="photo-screen">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="photo-img"
                    loading={index < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
              </button>
            );
          })}
        </div>
      </article>
    );
  })}

  <!-- Back to top -->
  <nav class="gallery-pager" aria-label="Back to top">
    <a href="#" class="pager-edge" data-pager-top>
      <span aria-hidden="true">↑</span> Back to top
    </a>
  </nav>
</section>

<!-- Lightbox -->
<div
  class="lightbox"
  id="modeling-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
  hidden
>
  <button class="lb-close" id="modeling-lb-close" aria-label="Close photo viewer" type="button">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
  <button class="lb-prev" id="modeling-lb-prev" aria-label="Previous photo" type="button">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15 4l-8 8 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="lb-stage">
    <div class="lb-frame">
      <img class="lb-img" id="modeling-lb-img" src="" alt="" />
    </div>
  </div>
  <button class="lb-next" id="modeling-lb-next" aria-label="Next photo" type="button">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <p class="lb-counter" id="modeling-lb-counter" aria-live="polite"></p>
</div>

<script define:vars={{ photoData: allModelingPhotos }}>
  function initModelingGallery() {
    const gallery = document.querySelector('[data-modeling-gallery]');
    if (!gallery || gallery.dataset.ready === 'true') return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cells = Array.from(gallery.querySelectorAll('.photo-cell'));
    const sections = Array.from(gallery.querySelectorAll('[data-location]'));
    const headers = Array.from(gallery.querySelectorAll('[data-parallax-header]'));

    const lb = document.getElementById('modeling-lightbox');
    const lbImg = document.getElementById('modeling-lb-img');
    const lbClose = document.getElementById('modeling-lb-close');
    const lbPrev = document.getElementById('modeling-lb-prev');
    const lbNext = document.getElementById('modeling-lb-next');
    const lbCount = document.getElementById('modeling-lb-counter');

    if (!lb || !lbImg || !lbClose || !lbPrev || !lbNext || !lbCount) return;

    gallery.dataset.ready = 'true';

    const srcs = photoData.map((p) => p.src);
    const alts = photoData.map((p) => p.alt);
    let current = 0;
    let previousFocus = null;

    // Reveal sections as they scroll into view
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
    );
    sections.forEach((section) => revealObserver.observe(section));

    // Subtle parallax on location headers
    if (!reduced && headers.length) {
      let ticking = false;
      const updateParallax = () => {
        headers.forEach((header) => {
          const rect = header.getBoundingClientRect();
          const vh = window.innerHeight;
          if (rect.bottom < 0 || rect.top > vh) return;
          const center = rect.top + rect.height / 2;
          const offset = (center - vh / 2) * 0.04;
          header.style.transform = `translateY(${offset}px)`;
        });
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateParallax);
          }
        },
        { passive: true },
      );
    }

    // Back-to-top pager edge
    const topLink = gallery.querySelector('[data-pager-top]');
    if (topLink) {
      topLink.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    // ── Lightbox ──────────────────────────────────
    const open = (i) => {
      previousFocus = document.activeElement;
      current = i;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      show(current);
      lbClose.focus();
    };

    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = '';
      previousFocus?.focus();
    };

    const show = (i) => {
      current = (i + srcs.length) % srcs.length;
      lbImg.classList.add('is-loading');
      lbImg.onload = () => lbImg.classList.remove('is-loading');
      lbImg.src = srcs[current];
      lbImg.alt = alts[current];
      lbCount.textContent = `${current + 1} / ${srcs.length}`;
    };

    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const idx = Number(cell.dataset.globalIndex);
        if (!Number.isNaN(idx)) open(idx);
      });
    });

    lbClose.addEventListener('click', close);
    lbPrev.addEventListener('click', () => show(current - 1));
    lbNext.addEventListener('click', () => show(current + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }

  initModelingGallery();
  document.addEventListener('astro:page-load', initModelingGallery);
</script>

<style>
  /* ── "Which?" gallery — black/white/red Swiss skin ── */
  .modeling-gallery {
    --cherry:      #A51C30;
    --cherry-deep: #7C0C28;
    --ink:         #111111;
    --paper:       #FFFFFF;
    --font-swiss: "Helvetica Neue", Helvetica, Arial, "Liberation Sans", sans-serif;

    position: relative;
    padding: clamp(3rem, 8vw, 6rem) var(--edge) clamp(4rem, 8vw, 7rem);
  }

  /* ── Location section + header ────────────────── */
  .location-section {
    margin-bottom: clamp(4rem, 8vw, 6.5rem);
    scroll-margin-top: 6.5rem;
  }

  .location-section:last-of-type {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .location-header {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .location-section.is-visible .location-header {
    opacity: 1;
    transform: translateY(0);
  }

  .location-title {
    font-family: var(--font-swiss);
    font-weight: 800;
    font-size: clamp(2rem, 6.5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  /* ── Photo grid of white "TV-screen" windows ──── */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: start;
  }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }

  .photo-cell {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    position: relative;
    opacity: 0;
    transform: translateY(0.85rem);
    transition:
      opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transition-delay: calc(var(--j, 0) * 0.05s);
  }

  .location-section.is-visible .photo-cell {
    opacity: 1;
    transform: translateY(0);
  }

  /* White rounded screen / window that frames each photo */
  .photo-screen {
    position: relative;
    display: block;
    background: var(--paper);
    /* soft "rounded-TV" corners, slightly oval */
    border-radius: clamp(2rem, 8%, 4.5rem) / clamp(2.5rem, 12%, 5.5rem);
    padding: clamp(0.2rem, 0.6vw, 0.4rem);
    overflow: hidden;
    transition: transform 0.35s ease;
  }

  .photo-cell:hover .photo-screen,
  .photo-cell:focus-visible .photo-screen {
    transform: translateY(-4px);
  }

  .photo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    display: block;
    border-radius: clamp(1.5rem, 6%, 3.5rem) / clamp(2rem, 10%, 4.5rem);
  }

  .photo-cell:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ── Back to top ──────────────────────────────── */
  .gallery-pager {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: clamp(1rem, 3vw, 2.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 2px solid var(--paper);
  }

  .pager-edge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-swiss);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .pager-edge:hover {
    border-color: var(--paper);
  }

  .pager-edge:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  /* ── Lightbox ─────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--cherry);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lb-in 0.25s ease both;
  }

  .lightbox[hidden] {
    display: none;
  }

  @keyframes lb-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lb-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 4rem 5rem;
  }

  /* White rounded screen in the viewer, echoing the grid */
  .lb-frame {
    padding: clamp(0.6rem, 1.4vw, 1rem);
    background: var(--paper);
    border-radius: clamp(2rem, 4vw, 4rem) / clamp(2.5rem, 5vw, 5rem);
    max-width: 100%;
    max-height: 100%;
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.35);
  }

  .lb-img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    object-fit: contain;
    border-radius: clamp(1.5rem, 3vw, 3rem) / clamp(2rem, 4vw, 4rem);
    transition: opacity 0.2s ease;
  }

  .lb-img.is-loading {
    opacity: 0;
  }

  .lb-close {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    color: var(--paper);
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    transition: color 0.2s;
    z-index: 2;
  }

  .lb-close:hover {
    color: var(--ink);
  }

  .lb-prev,
  .lb-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--paper);
    background: none;
    border: none;
    padding: 1rem;
    cursor: pointer;
    transition: color 0.2s;
    z-index: 2;
  }

  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  .lb-prev:hover,
  .lb-next:hover { color: var(--ink); }

  .lb-close:focus-visible,
  .lb-prev:focus-visible,
  .lb-next:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .lb-stage { padding: 4rem 1rem; }
    .lb-prev,
    .lb-next { display: none; }
  }

  .lb-counter {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-swiss);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--paper);
  }

  /* ── Reduced motion ───────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .location-header,
    .photo-cell {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .photo-img,
    .photo-screen {
      transition: none;
    }

    .photo-cell:hover .photo-screen,
    .photo-cell:focus-visible .photo-screen {
      transform: none;
    }

    .lightbox {
      animation: none;
    }
  }
</style>
