---
import type { ReelItem } from '../data/creator-content';
import { instagramUrl } from '../data/creator-content';

interface Props {
  reels: ReelItem[];
  /** Category label used for accessible reel link labels. */
  categoryLabel?: string;
}

const { reels, categoryLabel = 'Reel' } = Astro.props;
---

<div class="reel-row-wrap">
  <ul class="reel-row" data-stagger-grid style="--cols: 12">
    {reels.map((reel) => (
      <li class="reel-card" data-stagger-item>
        <a
          href={reel.url ?? instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={reel.title ?? `Reel on Instagram — ${categoryLabel}`}
        >
          <span class="reel-thumb-wrap">
            <img
              src={reel.src}
              alt=""
              class="reel-thumb"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <span class="reel-overlay" aria-hidden="true">
              <span class="rec-badge">REC</span>
              <span class="play-ring">
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="24" r="22" fill="rgba(245,242,236,0.12)" stroke="rgba(245,242,236,0.7)" stroke-width="1.5" />
                  <path d="M19 14l16 10-16 10V14z" fill="rgba(245,242,236,0.92)" />
                </svg>
              </span>
            </span>
            <span class="reel-frame" aria-hidden="true"></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .reel-row-wrap {
    position: relative;
  }

  .reel-row {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .reel-card {
    flex: 0 0 clamp(8rem, 16vw, 12rem);
  }

  .reel-card a {
    display: block;
    text-decoration: none;
  }

  .reel-thumb-wrap {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 14px;
    background: var(--cream-2);
    box-shadow: 0 6px 18px rgba(26, 25, 22, 0.1);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reel-card a:hover .reel-thumb-wrap,
  .reel-card a:focus-visible .reel-thumb-wrap {
    transform: translateY(-8px);
    box-shadow:
      0 18px 42px rgba(26, 25, 22, 0.18),
      0 0 0 1px rgba(181, 48, 42, 0.14);
  }

  .reel-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reel-card a:hover .reel-thumb,
  .reel-card a:focus-visible .reel-thumb {
    transform: scale(1.08);
  }

  .reel-frame {
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: 14px;
    transition: border-color 0.35s ease;
    pointer-events: none;
    z-index: 3;
  }

  .reel-card a:hover .reel-frame,
  .reel-card a:focus-visible .reel-frame {
    border-color: rgba(181, 48, 42, 0.4);
  }

  .reel-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 25, 22, 0.18);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  .reel-card a:hover .reel-overlay,
  .reel-card a:focus-visible .reel-overlay {
    opacity: 1;
  }

  .rec-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(245, 242, 236, 0.9);
    z-index: 4;
  }

  .rec-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #B5302A;
    animation: rec-pulse 1.4s ease-in-out infinite;
  }

  @keyframes rec-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .play-ring {
    display: flex;
    transform: scale(0.75);
    opacity: 0;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .play-ring svg { width: 44px; height: 44px; }

  .reel-card a:hover .play-ring,
  .reel-card a:focus-visible .play-ring {
    transform: scale(1);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .reel-row-wrap {
      margin-inline: calc(-1 * var(--edge));
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    }

    .reel-row {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0.75rem;
      padding-inline: var(--edge);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--edge);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .reel-row::-webkit-scrollbar { display: none; }

    .reel-card {
      flex: 0 0 clamp(9rem, 44vw, 11.5rem);
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel-thumb-wrap,
    .reel-thumb,
    .play-ring { transition: none; }

    .rec-badge::before { animation: none; }
  }
</style>
