---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: string;
}

const { title, description, date } = Astro.props;
---

<BaseLayout title={`${title} — Katya Ivshina`} description={description}>
  <main class="note-page">
    <article class="note" aria-labelledby="note-title">
      <header class="note-head">
        <a href="/notes" class="note-back">← Back to all notes</a>
        {date && <p class="note-date">{date}</p>}
        <h1 class="note-title" id="note-title">{title}</h1>
      </header>

      <div class="note-body prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .note-page { padding-top: 5.5rem; }

  .note {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--edge) 0;
  }

  .note-head {
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid rgba(26, 25, 22, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .note-back {
    align-self: flex-start;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-bottom: 1px solid rgba(26, 25, 22, 0.18);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .note-back:hover { color: #B5302A; border-color: #B5302A; }

  .note-date {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .note-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-optical-sizing: auto;
  }

  /* ── Prose ─────────────────────────────────────────── */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* Scoped styles can't reach slotted children, so use :global */
  .prose :global(p) {
    margin-bottom: 1.5rem;
    max-width: 65ch;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-optical-sizing: auto;
    margin: 2.5rem 0 1rem;
    scroll-margin-top: 6rem;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--ink);
    font-optical-sizing: auto;
    margin: 2rem 0 0.85rem;
  }

  .prose :global(em) { font-style: italic; }
  .prose :global(strong) { font-weight: 600; color: var(--ink); }

  .prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid rgba(181, 48, 42, 0.4);
    transition: color 0.2s, border-color 0.2s;
  }
  .prose :global(a:hover) { color: #B5302A; border-color: #B5302A; }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    max-width: 65ch;
  }
  .prose :global(li) { margin-bottom: 0.5rem; }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(181, 48, 42, 0.4);
    font-style: italic;
    color: var(--ink-2);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(26, 25, 22, 0.1);
    margin: 2.5rem 0;
  }
</style>
