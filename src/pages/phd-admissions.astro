---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  phdAdmissionsGuide,
  myApplicationMaterials,
  applicationChecklist,
  advisorEmailTemplate,
  recommendationLetterTemplates,
  phdStudentEmailTemplate,
  additionalExamples,
  nsfFeedbackLink,
} from '../data/phd-admissions';

const phdTestimonials = [
  "Katya's PhD admissions mentorship program was an excellent experience that provided insider information I couldn't find anywhere else. Thanks to her guidance, I now feel I'm at a next level of preparedness for PhD applications, with a clear advantage in understanding what top programs are really looking for.",
  'Every single thing Katya helped me with was extremely helpful! As a first generation person of color, this is the type of advice that I would otherwise spend months trying to dig for. She made me really believe in myself and my abilities!!',
  "This has probably been the best investment that I've ever made towards my future, every dollar was worth it.",
  'I loved how interactive this session was, you spent all your time going in depth and answering questions during your presentation and not leaving it all at the end! I enjoyed sharing our own experiences and hearing feedback',
  'I loved how realistic it was, and how you pulled from actual experience. You mentioning speaking to members in departments and admissions, as well as others you know was very insightful. Additionally your own experience and advice in applying was very engaging!',
  'It was a very well prepared presentation, and I liked that you spoke with honesty and shared your personal insights.',
];
---

<BaseLayout
  title="PhD Admissions Resources — Katya Ivshina"
  description="Katya Ivshina's STEM Ph.D. Admissions Guide plus free templates, checklists, email scripts, and her Harvard application materials."
>
  <main class="phd-page">

    <header class="page-hero">
      <h1 class="hero-title">PhD admissions<br /><em>toolkit.</em></h1>
      <p class="hero-sub text-subhead">
        A comprehensive guide to U.S. STEM Ph.D. admissions — plus free templates,
        checklists, and my own application materials. I hope this helps you on your
        admissions journey.
      </p>
      <p class="hero-note text-subhead">
        For live mentorship, see my
        <a href="#phd-heading" class="inline-link">PhD admissions coaching program</a>
        below — or join the upcoming
        <a href="/phd-admissions/workshop" class="inline-link">PhD admissions workshop</a>
        on August 12, 2026.
      </p>
    </header>

    <!-- Guide -->
    <section class="section section--linen guide-section" aria-labelledby="guide-heading">
      <div class="guide-grid">
        <div class="guide-copy">
          <h2 class="section-title" id="guide-heading">{phdAdmissionsGuide.title}</h2>
          <p class="guide-lead text-subhead">{phdAdmissionsGuide.headline}</p>

          <div class="guide-block">
            <h3 class="guide-block-title">Who it's for</h3>
            <p class="guide-block-body">{phdAdmissionsGuide.whoFor}</p>
          </div>

          <div class="guide-block">
            <h3 class="guide-block-title">Why this guide</h3>
            <p class="guide-block-body">{phdAdmissionsGuide.whyBuy}</p>
          </div>

          <div class="guide-block">
            <h3 class="guide-block-title">What's inside</h3>
            <ul class="guide-topics" role="list">
              {phdAdmissionsGuide.topics.map((topic) => (
                <li class="guide-topic">
                  <span class="guide-topic-title">{topic.title}</span>
                  <span class="guide-topic-detail">{topic.detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={phdAdmissionsGuide.purchaseUrl}
            class="guide-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            {phdAdmissionsGuide.ctaLabel} →
          </a>
        </div>

        <figure class="guide-visual">
          <img
            src={phdAdmissionsGuide.screenshot}
            alt={phdAdmissionsGuide.screenshotAlt}
            width="900"
            height="1200"
            loading="eager"
            decoding="async"
            class="guide-screenshot"
          />
        </figure>
      </div>
    </section>

    <!-- Coaching program -->
    <section class="section coaching-section" aria-labelledby="phd-heading">
      <div class="section-intro">
        <h2 class="section-title" id="phd-heading">Signature PhD admissions coaching program</h2>
        <p class="section-body text-subhead">
          I run my signature PhD admissions coaching program, a mentorship program built on insider
          guidance I wish I had when applying: what committees look for, how to research programs,
          funding, statements of purpose, letters, and timelines. Free templates and my application
          materials are below.
        </p>
      </div>

      <h3 class="postcards-heading">What Katya's mentees say</h3>
      <div class="postcard-grid postcard-grid--phd">
        {phdTestimonials.map((quote, i) => (
          <figure class={`postcard postcard--${(i % 3) + 1}`}>
            <blockquote class="postcard-quote">
              <p>"{quote}"</p>
            </blockquote>
          </figure>
        ))}
      </div>
    </section>

    <!-- My materials -->
    <section class="section" aria-labelledby="materials-heading">
      <div class="section-inner">
        <p class="text-caption section-label" id="materials-heading">My application</p>
        <h2 class="section-title">CV, statement of purpose & research proposal</h2>
        <p class="section-body text-subhead">
          These are the documents I used when applying to Harvard. Use them as reference —
          not as templates to copy verbatim.
        </p>

        <ul class="material-list" role="list">
          {myApplicationMaterials.map((item) => (
            <li class="material-item">
              <a
                href={item.href}
                class="material-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="material-title">{item.title}</span>
                <span class="material-meta">{item.fileType} →</span>
              </a>
              <p class="material-desc">{item.description}</p>
            </li>
          ))}
        </ul>

        <p class="section-footnote">
          <a href={nsfFeedbackLink.href} class="inline-link" target="_blank" rel="noopener noreferrer">
            {nsfFeedbackLink.title} →
          </a>
        </p>
      </div>
    </section>

    <!-- Checklist -->
    <section class="section section--linen" aria-labelledby="checklist-heading">
      <div class="section-intro">
        <h2 class="section-title" id="checklist-heading">Application checklist</h2>
        <p class="section-body text-subhead">{applicationChecklist.intro}</p>
      </div>

      <div class="checklist-grid">
        <div class="checklist-block">
          <h3 class="checklist-heading">Required for most programs</h3>
          <ul class="checklist" role="list">
            {applicationChecklist.required.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="checklist-block">
          <h3 class="checklist-heading">Sometimes required</h3>
          <ul class="checklist checklist--optional" role="list">
            {applicationChecklist.optional.map((item) => (
              <li>
                <strong>{item.label}</strong>
                <span class="checklist-note">{item.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Email templates -->
    <section class="section" aria-labelledby="templates-heading">
      <div class="section-intro">
        <h2 class="section-title" id="templates-heading">Email templates</h2>
      </div>

      <article class="template-card">
        <h3 class="template-title">Contacting potential PhD advisors</h3>
        <p class="template-note">{advisorEmailTemplate.note}</p>
        <pre class="template-body">{advisorEmailTemplate.body}</pre>
      </article>

      <div class="template-group">
        <h3 class="template-title">Asking for recommendation letters</h3>
        {recommendationLetterTemplates.map((t) => (
          <article class="template-card">
            <h3 class="template-title">{t.title}</h3>
            {t.intro && <p class="template-note">{t.intro}</p>}
            {t.highlight && <p class="template-highlight">{t.highlight}</p>}
            <pre class="template-body">{t.body}</pre>
          </article>
        ))}
      </div>

      <article class="template-card">
        <h3 class="template-title">Contacting PhD students to learn about the labs you're applying to</h3>
        <p class="template-note">{phdStudentEmailTemplate.note}</p>
        <pre class="template-body">{phdStudentEmailTemplate.body}</pre>
      </article>
    </section>

    <!-- More examples -->
    <section class="section section--linen" aria-labelledby="examples-heading">
      <div class="section-inner">
        <h2 class="section-title" id="examples-heading">{additionalExamples.title}</h2>
        <p class="section-body text-subhead">{additionalExamples.description}</p>
        <a
          href={additionalExamples.href}
          class="resource-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open the database →
        </a>
      </div>
    </section>

    <section class="section cta-section" aria-labelledby="phd-cta">
      <p class="text-caption section-label">1-on-1 consultations</p>
      <h2 class="cta-title" id="phd-cta">Book a personal<br /><em>admissions consultation.</em></h2>
      <a href="mailto:ekaterina.s.ivshina@gmail.com" class="cta-link">Get in touch →</a>
    </section>

  </main>
</BaseLayout>

<style>
  .phd-page { padding-top: 5.5rem; }

  .page-hero {
    padding: clamp(2.5rem, 5vw, 4rem) var(--edge) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgba(26, 25, 22, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6.5vw, 6rem);
    font-weight: 200;
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--ink);
    font-optical-sizing: auto;
  }

  .hero-title em { font-style: italic; }
  .hero-sub { max-width: 52ch; }
  .hero-note { max-width: 52ch; font-size: 0.9375rem; color: var(--ink-2); }

  .guide-section { padding-top: clamp(3rem, 6vw, 4.5rem); }

  .guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 22rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    max-width: 68rem;
  }

  .guide-lead {
    max-width: 48ch;
    margin-bottom: 1.75rem;
    font-size: 1.0625rem;
  }

  .guide-block { margin-bottom: 1.75rem; }

  .guide-block-title {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .guide-block-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .guide-topics {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 52ch;
  }

  .guide-topic {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 1.25rem;
    position: relative;
  }

  .guide-topic::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border: 1px solid #B5302A;
    border-radius: 1px;
  }

  .guide-topic-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
    font-optical-sizing: auto;
  }

  .guide-topic-detail {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .guide-cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.85rem 1.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    background: #B5302A;
    border-radius: 999px;
    transition: background 0.2s, transform 0.2s;
  }

  .guide-cta:hover {
    background: #952822;
    transform: translateY(-1px);
  }

  .guide-visual {
    position: sticky;
    top: 6rem;
    margin: 0;
  }

  .guide-screenshot {
    width: 100%;
    border: 1px solid rgba(26, 25, 22, 0.1);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgba(26, 25, 22, 0.08);
  }

  .guide-caption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--ink-3);
  }

  @media (max-width: 820px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .guide-visual {
      order: -1;
      position: static;
      max-width: 22rem;
      margin-inline: auto;
    }
  }

  .inline-link {
    color: #B5302A;
    border-bottom: 1px solid rgba(181, 48, 42, 0.3);
    transition: border-color 0.2s;
  }
  .inline-link:hover { border-color: #B5302A; }

  /* ── Coaching testimonials (postcards) ── */
  .coaching-section .section-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .postcards-heading {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .postcard-grid--phd {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    max-width: 72rem;
  }

  .postcard {
    position: relative;
    margin: 0;
    padding: 1.5rem 1.35rem 1.35rem;
    background: #FAF8F3;
    border: 1px solid rgba(26, 25, 22, 0.1);
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgba(26, 25, 22, 0.04),
      0 8px 24px rgba(26, 25, 22, 0.06);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s;
  }

  .postcard:hover {
    transform: translateY(-3px) rotate(0deg) !important;
    box-shadow:
      0 2px 4px rgba(26, 25, 22, 0.06),
      0 14px 32px rgba(26, 25, 22, 0.08);
  }

  .postcard--1 { transform: rotate(-0.6deg); }
  .postcard--2 { transform: rotate(0.4deg); }
  .postcard--3 { transform: rotate(-0.3deg); }

  .postcard-quote {
    margin: 0;
  }

  .postcard-quote p {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.65;
    color: var(--ink);
    font-optical-sizing: auto;
  }

  .section { padding: var(--section) var(--edge); border-bottom: 1px solid rgba(26, 25, 22, 0.08); }
  .section--linen { background: var(--cream-2); }
  .section-inner, .section-intro { max-width: 42rem; }
  .section-intro { margin-bottom: 2rem; }
  .section-label { margin-bottom: 0.75rem; }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
    font-optical-sizing: auto;
  }
  .section-body { max-width: 52ch; margin-bottom: 1.25rem; }
  .section-footnote { margin-top: 1.5rem; font-size: 0.875rem; }

  .material-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .material-item { padding-bottom: 1.25rem; border-bottom: 1px solid rgba(26, 25, 22, 0.08); }
  .material-item:last-child { border-bottom: none; padding-bottom: 0; }

  .material-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    color: var(--ink);
    transition: color 0.2s;
  }
  .material-link:hover { color: #B5302A; }

  .material-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    font-optical-sizing: auto;
  }

  .material-meta {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .material-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .checklist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2rem;
    max-width: 56rem;
  }

  .checklist-heading {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .checklist li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border: 1px solid #B5302A;
    border-radius: 1px;
  }

  .checklist--optional li { display: flex; flex-direction: column; gap: 0.15rem; }
  .checklist--optional strong { color: var(--ink); font-weight: 500; }
  .checklist-note { font-size: 0.8125rem; color: var(--ink-3); }

  .template-group { max-width: 44rem; }

  .template-card {
    max-width: 44rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(26, 25, 22, 0.08);
  }
  .section > .template-card:last-of-type { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

  .template-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    margin-bottom: 0.65rem;
    font-optical-sizing: auto;
  }

  .template-note, .template-highlight {
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .template-highlight {
    font-style: italic;
    padding-left: 0.75rem;
    border-left: 2px solid #B5302A;
  }

  .template-body {
    font-family: var(--font-body, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--ink-2);
    background: var(--cream-2);
    border: 1px solid rgba(26, 25, 22, 0.08);
    border-radius: 8px;
    padding: 1.25rem 1.15rem;
    white-space: pre-wrap;
    overflow-x: auto;
    margin: 0;
  }

  .resource-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .resource-link:hover { color: #B5302A; border-color: #B5302A; }

  .cta-section { border-bottom: none; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    font-optical-sizing: auto;
  }
  .cta-title em { font-style: italic; color: var(--accent); }
  .cta-link {
    display: inline-block;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .cta-link:hover { color: #B5302A; border-color: #B5302A; }
</style>
