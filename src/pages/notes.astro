---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Note {
  href: string;
  title: string;
  date: string;
  excerpt: string;
}

const notes: Note[] = [
  {
    href: '/notes/qft-nn',
    title: 'Correspondence between Quantum Field Theory and Neural Networks',
    date: 'Jan ’22',
    excerpt:
      'My final paper from Princeton’s graduate QFT class (PHY509), reviewing the correspondence between Quantum Field Theory and Neural Networks.',
  },
  {
    href: '/notes/faith-at-work',
    title: 'Faith at work',
    date: 'Apr ’23',
    excerpt:
      'A reflection on the Faith at Work movement, employer-provided chaplaincy, and the ethics of integrating belief with the workplace.',
  },
];
---

<BaseLayout
  title="Notes — Katya Ivshina"
  description="Essays and notes by Katya Ivshina on physics, machine learning, ethics, and the spaces in between."
>
  <main class="notes-page">
    <header class="page-hero">
      <p class="text-caption hero-label">Notes</p>
      <h1 class="hero-title">Things I’ve been<br /><em>thinking about.</em></h1>
      <p class="hero-sub text-subhead">
        A small collection of essays and notes — from the mathematics of quantum field theory
        to the ethics of faith in the workplace.
      </p>
    </header>

    <section class="note-list-section" aria-label="All notes">
      <ul class="note-list" role="list">
        {notes.map((note) => (
          <li class="note-item">
            <a href={note.href} class="note-link">
              <p class="note-item-date">{note.date}</p>
              <h2 class="note-item-title">{note.title}</h2>
              <p class="note-item-excerpt">{note.excerpt}</p>
              <span class="note-item-cta" aria-hidden="true">Read note →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .notes-page { padding-top: 5.5rem; }

  .page-hero {
    padding: clamp(2.5rem, 5vw, 4rem) var(--edge) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgba(26, 25, 22, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6.5vw, 6rem);
    font-weight: 200;
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--ink);
    font-optical-sizing: auto;
  }
  .hero-title em { font-style: italic; }
  .hero-sub { max-width: 52ch; }

  .note-list-section { padding: var(--section) var(--edge); }

  .note-list {
    list-style: none;
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .note-item { border-bottom: 1px solid rgba(26, 25, 22, 0.1); }
  .note-item:first-child { border-top: 1px solid rgba(26, 25, 22, 0.1); }

  .note-link {
    display: block;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    transition: padding-left 0.25s ease;
  }
  .note-link:hover { padding-left: 0.65rem; }

  .note-item-date {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.6rem;
  }

  .note-item-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-optical-sizing: auto;
    margin-bottom: 0.65rem;
    transition: color 0.2s;
  }
  .note-link:hover .note-item-title { color: #B5302A; }

  .note-item-excerpt {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 60ch;
    margin-bottom: 0.85rem;
  }

  .note-item-cta {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #B5302A;
  }

  @media (prefers-reduced-motion: reduce) {
    .note-link { transition: none; }
    .note-link:hover { padding-left: 0; }
  }
</style>
