---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import CreatorLinkIcon from '../components/CreatorLinkIcon.astro';
import { creatorLinks, newsletterUrl, type CreatorLink } from '../data/creator-content';

/** Home hero socials — order differs from the creator page. */
const homeSocialLinkOrder = [
  'LinkedIn',
  'Instagram',
  'Patreon',
  'Newsletter',
  'YouTube',
  'YouTube (Russian)',
  'Résumé',
] as const;

const homeSocialLinks = homeSocialLinkOrder
  .map((label) => creatorLinks.find((link) => link.label === label))
  .filter((link): link is CreatorLink => link !== undefined);

// Home-page hero portrait (5152 × 7728). Imported so Astro optimizes the
// large source into a light, responsive asset.
import heroImg from '../../img/DSCF0626.jpg';

/** Home bio — first paragraph plain text; second has an inline link. */
const bioLead =
  'Katya Ivshina is a mathematician, machine learning researcher, and educator. She holds a B.A. in mathematics, with honors, from Princeton and an M.S. in Applied Mathematics from Harvard, and is a recipient of the NSF Graduate Research Fellowship. Her work spans machine learning systems and geometry, carried out at Harvard, MIT, and Apple — with an exoplanet discovery under her belt.';

const manifoldLearningUrl = 'https://www.instagram.com/manifold.learning/';
---

<BaseLayout
  title="Katya Ivshina"
  description="Katya Ivshina — mathematician, machine learning researcher, and educator. Princeton BA · Harvard Applied Mathematics · NSF Graduate Research Fellow."
>
  <main class="home">
    <section class="hero" aria-label="Introduction">
      <div class="hero-text" data-reveal>
        <p class="text-caption hero-eyebrow">Mathematician · ML researcher · educator</p>

        <h1 class="hero-title">Katya Ivshina</h1>

        <div class="hero-bio">
          <p class="text-subhead">{bioLead}</p>
          <p class="text-subhead">
            Alongside her research, Katya teaches machine learning for a global audience of more than 100,000 followers and 30+ million views, and is building a ML school called{' '}
            <a href={manifoldLearningUrl} target="_blank" rel="noopener noreferrer">Manifold Learning</a>, grounded in rigor and plain language. A visual storyteller, dancer, and musician, she builds at the intersection of mathematics and creativity.
          </p>
        </div>

        <div class="hero-actions">
          <a
            href={newsletterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta"
          >
            Join the mailing list
            <span class="hero-cta-arrow" aria-hidden="true">→</span>
          </a>

          <nav class="hero-socials" aria-label="Katya Ivshina elsewhere">
            <p class="text-caption hero-socials-label">Find me</p>
            <ul class="hero-socials-list" role="list">
              {homeSocialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={['hero-social-link', { 'hero-social-link--accent': link.emphasis }]}
                    aria-label={`Katya Ivshina — ${link.label}`}
                    {...(link.external && link.href !== '#'
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    <CreatorLinkIcon icon={link.icon} />
                    <span class="hero-social-label">{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>

      <figure class="hero-photo" data-reveal>
        <Image
          src={heroImg}
          alt="Katya Ivshina"
          widths={[400, 600, 800]}
          sizes="(max-width: 820px) 80vw, 26rem"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>
  </main>
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────
     HOME — sleek, professional, on brand.
     Hero: portrait + bio + mailing-list link, built
     entirely on the site design tokens (global.css).
  ───────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(5rem, 10vh, 7rem) var(--edge) var(--section);
  }

  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 200;
    font-style: italic;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: #952822;
    font-optical-sizing: auto;
  }

  .hero-bio {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-bio a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: rgba(26, 25, 22, 0.35);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .hero-bio a:hover {
    color: #B5302A;
    text-decoration-color: #B5302A;
  }

  .hero-actions {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .hero-socials {
    width: 100%;
    align-self: stretch;
  }

  .hero-socials-label {
    margin-bottom: 0.65rem;
    color: var(--ink-2);
  }

  .hero-socials-list {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.35rem 0.3rem;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-gutter: stable;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.15rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(26, 25, 22, 0.18) transparent;
  }

  .hero-socials-list::-webkit-scrollbar {
    height: 4px;
  }

  .hero-socials-list::-webkit-scrollbar-thumb {
    background: rgba(26, 25, 22, 0.18);
    border-radius: 999px;
  }

  .hero-social-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    background: rgba(26, 25, 22, 0.04);
    border: 1px solid rgba(26, 25, 22, 0.08);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-social-link :global(svg) {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
  }

  .hero-social-link:hover,
  .hero-social-link:focus-visible {
    color: var(--accent);
    background: rgba(181, 48, 42, 0.06);
    border-color: rgba(181, 48, 42, 0.2);
    transform: translateY(-1px);
    outline: none;
  }

  .hero-social-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hero-social-link--accent {
    color: var(--ink);
    font-weight: 600;
  }

  .hero-social-label {
    white-space: nowrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .hero-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .hero-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .hero-cta-arrow {
    transition: transform 0.25s ease;
  }

  .hero-cta:hover .hero-cta-arrow {
    transform: translateX(4px);
  }

  /* Portrait — clean framed image, subtle depth */
  .hero-photo {
    margin: 0;
    margin-top: clamp(0.75rem, 4vh, 2.5rem);
    justify-self: end;
    width: 100%;
    max-width: 26rem;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1.5rem 3.5rem rgba(26, 25, 22, 0.18);
  }

  .hero-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Keep the portrait framed and fully within the viewport on desktop:
     the figure owns the height cap, the image covers it so the frame
     is always filled (no letterboxing or narrow strip). */
  @media (min-width: 821px) {
    .hero-photo {
      max-height: calc(100dvh - 10rem);
      aspect-ratio: 2 / 3;
      /* Pull the right edge out of the centered 72rem hero box so it
         lines up with the full-width header gutter (where the nav ends).
         The offset equals the hero's auto side-margin; 0 until the hero
         is clamped at its max-width. */
      margin-right: min(0px, calc((72rem - 100vw) / 2));
    }
  }

  /* ── Scroll reveal (self-contained; JS adds .is-in) ── */
  .home :global([data-reveal]) {
    opacity: 0;
    transform: translateY(1.75rem);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.16, 0.84, 0.34, 1);
  }

  .home :global([data-reveal].is-in) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger the portrait slightly behind the text */
  .hero-photo {
    transition-delay: 0.12s;
  }

  /* ── Responsive ── */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
      padding-top: clamp(4.5rem, 12vh, 7rem);
    }

    .hero-text {
      order: 1;
      min-width: 0;
    }

    .hero-photo {
      order: 0;
      max-width: 18rem;
      justify-self: center;
    }

    .hero-bio {
      margin-inline: auto;
    }

    .hero-actions {
      align-items: center;
    }

    /* Wrap the social pills into centred rows on mobile instead of a
       single non-wrapping strip, which otherwise forces the hero column
       to its ~1065px min-content width and overflows the viewport. */
    .hero-socials-list {
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
    }

    /* ≥44px touch target for the social pills on mobile. */
    .hero-social-link {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home :global([data-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /**
   * Home hero scroll reveal.
   * Adds `.is-in` to [data-reveal] elements as they enter the viewport.
   * Falls back to showing everything when IntersectionObserver is
   * unavailable or the user prefers reduced motion — content is never
   * left stranded at opacity:0.
   */
  function initHomeReveals(): void {
    const root = document.querySelector<HTMLElement>('.home');
    if (!root || root.dataset.revealBound === 'true') return;
    root.dataset.revealBound = 'true';

    const els = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (els.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    );

    els.forEach((el) => observer.observe(el));
  }

  initHomeReveals();
  document.addEventListener('astro:page-load', initHomeReveals);
</script>
