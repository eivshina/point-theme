  .cr-panel--tilt-r[data-reveal] { transform: translateY(2.5rem) rotate(0.5deg); }
  .cr-panel--tilt-l[data-reveal].is-in { transform: translateY(0) rotate(-0.5deg); }
  .cr-panel--tilt-r[data-reveal].is-in { transform: translateY(0) rotate(0.5deg); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1024px) {
