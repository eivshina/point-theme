  /* ── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-stagger-item],
    .cr-intro-statement {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
