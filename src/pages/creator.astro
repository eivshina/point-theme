</style>

<script>
  function initCreatorMotion(): void {
    const main = document.querySelector<HTMLElement>('.creator');
    if (!main || main.dataset.motionBound === 'true') return;
    main.dataset.motionBound = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1 · Generic scroll reveals (sections, panels, CTA).
    const hero = document.querySelector<HTMLElement>('.cr-hero');
    hero?.classList.add('is-in');

    const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]')).filter(
      (el) => el !== hero,
    );
    if (reduced) {
      revealEls.forEach((el) => el.classList.add('is-in'));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    }

    // 2 · Column-staggered grid reveal (brand wall).
    const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-stagger-grid]'));
    grids.forEach((grid) => {
      const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-stagger-item]'));
      if (reduced) {
        items.forEach((item) => item.classList.add('is-in'));
        return;
      }
      const cols = Number(getComputedStyle(grid).getPropertyValue('--cols')) || 5;
      const staggerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const col = items.indexOf(el) % cols;
            el.style.setProperty('--stagger-delay', `${col * 60}ms`);
            el.classList.add('is-in');
            staggerObserver.unobserve(el);
          });
        },
        { threshold: 0.15 },
      );
      items.forEach((item) => staggerObserver.observe(item));
    });

    if (reduced) return;

    // 3 · Sticky scroll-zoom intro + statement reveal + backdrop parallax.
    const introWrap = document.querySelector<HTMLElement>('[data-intro]');
    const strip = document.querySelector<HTMLElement>('[data-intro-strip]');
    const statement = document.querySelector<HTMLElement>('[data-intro-statement]');
    const backdrop = document.querySelector<HTMLElement>('.film-strip--v');
    const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

    const clamp = (v: number, lo = 0, hi = 1): number => Math.min(hi, Math.max(lo, v));

    let ticking = false;
    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const vh = window.innerHeight;

        if (introWrap && strip) {
          const rect = introWrap.getBoundingClientRect();
          const total = rect.height - vh;
          const p = total > 0 ? clamp(-rect.top / total) : 0;
          strip.style.transform = `scale(${0.74 + p * 0.5})`;

          if (statement) {
            const t = clamp((p - 0.35) / 0.4);
            statement.style.opacity = String(t);
            statement.style.transform = `translateY(${(1 - t) * 24}px)`;
          }
        }

        if (backdrop) {
          backdrop.style.setProperty('--backdrop-shift', `${window.scrollY * -0.04}px`);
        }

        parallaxEls.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const progress = (rect.top + rect.height / 2) / vh - 0.5;
          const depth = Number(el.dataset.parallax) || 0;
          el.style.translate = `0 ${progress * depth * -120}px`;
        });

        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  }

  initCreatorMotion();
  document.addEventListener('astro:page-load', initCreatorMotion);
</script>
